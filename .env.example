# Copy to .env and fill in. Never commit .env.

# Folder where EU4 writes .eu4 files.
# Windows default: C:\Users\<you>\Documents\Paradox Interactive\Europa Universalis IV\save games
EU4_SAVE_DIR=

# EU4 installation folder (the one containing eu4.exe). Used for country/province
# names (localisation/) and game mechanics data (common/).
# Steam default: C:\Program Files (x86)\Steam\steamapps\common\Europa Universalis IV
EU4_GAME_DIR=

# Optional: language for country/province names (english, spanish, french, german).
# By default it is read from the game's settings.txt.
# EU4_LANGUAGE=

# Required for `chancellor chat`. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the chat model (default claude-sonnet-5-5) and how much it thinks
# before answering (low, medium, high, xhigh, max; default medium).
# CHANCELLOR_MODEL=claude-sonnet-5-5
# CHANCELLOR_EFFORT=medium

# Optional: the API budget in US dollars (D-028). The app keeps a running total of what
# it spent and refuses questions past the budget; one question stops before its cap.
# CHANCELLOR_API_BUDGET_USD=5
# CHANCELLOR_QUESTION_CAP_USD=0.50

# Optional: the desktop panel's system-wide shortcut (default ctrl+shift+space). With
# one screen it opens and closes the overlay; with two it brings Claude Desktop forward.
# CHANCELLOR_HOTKEY=ctrl+shift+space
