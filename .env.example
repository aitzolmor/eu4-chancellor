# Copy to .env and fill in. Never commit .env.

# Folder where EU4 writes .eu4 files.
# Windows default: C:\Users\<you>\Documents\Paradox Interactive\Europa Universalis IV\save games
EU4_SAVE_DIR=

# EU4 installation folder (the one containing eu4.exe). Used for country/province
# names (localisation/) and game mechanics data (common/).
# Steam default: C:\Program Files (x86)\Steam\steamapps\common\Europa Universalis IV
EU4_GAME_DIR=

# Required from Phase 2 (chat window). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the default model.
# CHANCELLOR_MODEL=claude-sonnet-5-5
